import pandas as pd
import numpy as np

# ======================== Задание 1 ========================
df = pd.read_csv('data.csv')
print("DataFrame из data.csv:")
print(df.head())

# ======================== Задание 2 ========================
df['Title'] = df['Name'].str.extract(r',\s*([A-Za-z]+)\.')
print("\nСтолбец с титулами:")
print(df[['Name', 'Title']].head(10))

# ======================== Задание 3 ========================
male_df = df[df['Sex'] == 'male'].copy()
male_df['FirstName'] = male_df['Name'].str.extract(r',\s*[A-Za-z]+\.\s+(\w+)')
most_common_male_name = male_df['FirstName'].mode()[0]
print(f"\nНаиболее часто встречающееся имя среди мужчин: {most_common_male_name}")

# ======================== Задание 4 ========================
married_df = df[df['Title'] == 'Mrs'].copy()
married_df['FirstName'] = married_df['Name'].str.extract(r',\s*Mrs\.\s+(\w+)')
name_counts = married_df['FirstName'].value_counts()
same_name_count = name_counts[name_counts > 1].sum()
print(f"\nКоличество замужних женщин, у которых одинаковое имя: {same_name_count}")
print("Имена (встречаются больше одного раза):")
print(name_counts[name_counts > 1])

# ======================== Задание 5 ========================
nums = [2024, 12, 31, 10, 20]
dt = pd.to_datetime({'year': [nums[0]], 'month': [nums[1]], 'day': [nums[2]],
                     'hour': [nums[3]], 'minute': [nums[4]]})
print(f"\nОбъект datetime (31 декабря 2024, 10:20):")
print(dt)

# ======================== Задание 6 ========================
print(f"\nГод из созданного объекта: {dt.dt.year[0]}")

# ======================== Задание 7 ========================
df_bp = pd.read_csv('BP.csv')
print("\nDataFrame из BP.csv:")
print(df_bp.head())

# ======================== Задание 8 ========================
df_bp['date'] = pd.to_datetime(df_bp['date'])
df_bp = df_bp.set_index('date').sort_index()
print("\nПосле установки столбца 'date' в качестве индекса:")
print(df_bp.head())

# ======================== Задание 9 ========================
monthly_sales = df_bp['sales'].resample('ME').sum()
avg_monthly_sales = monthly_sales.mean()
print(f"\nСреднее количество проданного товара за один месяц: {avg_monthly_sales:.2f}")

# ======================== Задание 10 ========================
h1_2013 = df_bp.loc['2013-01-01':'2013-06-30', 'sales'].sum()
h2_2013 = df_bp.loc['2013-07-01':'2013-12-31', 'sales'].sum()
diff = h2_2013 - h1_2013
print(f"\nСуммарные продажи в первом полугодии 2013: {h1_2013}")
print(f"Суммарные продажи во втором полугодии 2013: {h2_2013}")
print(f"Изменение (2е полугодие - 1е полугодие): {diff}")
